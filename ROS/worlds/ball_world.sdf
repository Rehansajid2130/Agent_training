<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="ball_follower_world">
    <!-- Sunlight -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Target Yellow Ball (Physical sphere for robot to detect and follow) -->
    <model name="yellow_ball">
      <pose>2.0 0.5 0.2 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.0032</ixx>
            <iyy>0.0032</iyy>
            <izz>0.0032</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.2</radius>
            </geometry>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.2</radius>
            </geometry>
          </geometry>
          <material>
            <ambient>1.0 0.84 0.0 1.0</ambient>
            <diffuse>1.0 0.84 0.0 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

