# ==============================================================================
# Git Ignore Rules for AI_training (Reinforcement Learning + ROS 2 Robotics)
# ==============================================================================

# ------------------------------------------------------------------------------
# Python & Bytecode Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.manifest
*.spec

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Type Checking
.pytest_cache/
.coverage
.coverage.*
.mypy_cache/
.tox/
.cache/

# ------------------------------------------------------------------------------
# ROS 2 & Colcon Build Artifacts (Crucial for ROS / autonomous_nav_ws)
# ------------------------------------------------------------------------------
# Build, install, and log folders generated by `colcon build`
**/build/
**/install/
**/log/
COLCON_IGNORE

# ROS 2 Bags & Telemetry Recordings (Large binaries)
*.db3
*.mcap
rosbag2_*/

# Process IDs & lock files
*.pid
*.lock

# ------------------------------------------------------------------------------
# Gazebo Harmonic / Ignition Simulation Caches & Logs
# ------------------------------------------------------------------------------
.gz/
.ignition/
*.log
gazebo.log
sim.log

# ------------------------------------------------------------------------------
# Machine Learning & Training Artifacts
# ------------------------------------------------------------------------------
# TensorBoard logs & checkpoints
runs/
tensorboard/
*.tfevents.*

# Temporary video render buffers & scratch folders
temp/
tmp/
*.tmp
*.mp4.tmp

# ------------------------------------------------------------------------------
# Operating System Junk Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory

# ------------------------------------------------------------------------------
# IDE & Code Editors
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
